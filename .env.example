# ================================
# MongoDB
# ================================
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_DB=vectra_cloud

# ================================
# Auth (session HMAC)
# ================================
AUTH_SECRET=generate-a-long-random-string

# ================================
# e2b-gateway (sandbox control plane)
# ================================
XIBECODE_SANDBOX_GATEWAY_URL=http://127.0.0.1:8787
XIBECODE_GATEWAY_TOKEN=

# Public HTTPS origin of this site (for Telegram setWebhook → auto-resume on DM).
# Not localhost — use ngrok/deploy URL, e.g. https://cloud.example.com
PUBLIC_BASE_URL=

# ================================
# Razorpay ($4 USD / instance / month)
# ================================
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx
# Optional webhook secret from Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=

# ================================
# Docs AI chat (optional)
# ================================
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
