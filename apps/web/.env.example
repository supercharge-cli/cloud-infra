# ================================
# MongoDB
# ================================
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_DB=vectra_cloud

# ================================
# Auth
# ================================
AUTH_SECRET=generate-a-long-random-string
# Comma-separated emails always treated as admin (in addition to role: admin in DB)
ADMIN_EMAILS=iotserver24@gmail.com
# Creates/syncs those emails as role=admin with this password on every cold start
ADMIN_BOOTSTRAP_PASSWORD=

# ================================
# Gateway (Railway / Coolify URL in production)
# ================================
# Public HTTPS origin of the gateway (Railway/Coolify). NEVER use localhost on Vercel.
# Do NOT put a Cloudflare orange-cloud domain here (bot challenge blocks Vercel → gateway).
# Prefer *.up.railway.app or Coolify direct URL with DNS-only (grey cloud).
XIBECODE_SANDBOX_GATEWAY_URL=http://127.0.0.1:8787
# Must match gateway process env XIBECODE_GATEWAY_TOKEN exactly
XIBECODE_GATEWAY_TOKEN=

# Public HTTPS origin (Telegram wake webhook, etc.)
PUBLIC_BASE_URL=

# ================================
# Pricing (change anytime; redeploy / restart to apply)
# ================================
BILLING_PRICE_INR=399
BILLING_PRICE_USD=4.59
BILLING_PERIOD_DAYS=30
# Optional exact Razorpay minor units (defaults = price × 100)
# BILLING_AMOUNT_PAISE=39900
# BILLING_AMOUNT_CENTS=459
# Optional plan metadata
# BILLING_PLAN_ID=hosting-4c8g
# BILLING_PLAN_NAME=Vectra Cloud instance
# Optional client-visible mirrors (marketing); charges use BILLING_* above
# NEXT_PUBLIC_BILLING_PRICE_INR=399
# NEXT_PUBLIC_BILLING_PRICE_USD=4.59

# ================================
# Razorpay
# ================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# ================================
# Docs AI chat (optional)
# ================================
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
