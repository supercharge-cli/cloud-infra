{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["fra1"],
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/arm-telegram-wake",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/billing-lifecycle",
      "schedule": "30 6 * * *"
    }
  ]
}

