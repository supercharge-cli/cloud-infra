# Cloud provider API key (gateway only — never on the frontend)
E2B_API_KEY=

# Shared secret — same value as XIBECODE_GATEWAY_TOKEN on the web app
XIBECODE_GATEWAY_TOKEN=

PORT=8787

# Sandbox image / sizing template
XIBECODE_E2B_TEMPLATE=xibecode-full-sandbox
# https://e2b.dev/docs/sandbox/auto-resume
# onTimeout=pause (full memory snapshot) + autoResume=true — wake on SDK/HTTP activity
XIBECODE_E2B_ON_TIMEOUT=pause
XIBECODE_E2B_AUTO_RESUME=true
# Idle pause after this many ms (default 30m). After auto-resume E2B restarts countdown (min 5m).
# Idle before pause (ms). Default 15m = 900000; 30m = 1800000
XIBECODE_E2B_SANDBOX_TIMEOUT_MS=900000
# Pause+resume before E2B 24h continuous-run hard limit (default 23h). 0=off.
XIBECODE_E2B_MAX_CONTINUOUS_MS=82800000
# Optional Rust-agent template override. Leave commented for the legacy template.
# XIBECODE_E2B_TEMPLATE=superagent-interactive-sandbox
# XIBECODE_SANDBOX_DAEMON_COMMAND=superagent-server
# XIBECODE_SANDBOX_DAEMON_PIDFILE=/tmp/superagent-daemon.pid
# XIBECODE_SANDBOX_DAEMON_LOGFILE=/tmp/superagent-daemon.log
# XIBECODE_SANDBOX_DAEMON_MATCH=superagent-server
