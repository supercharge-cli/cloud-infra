# Cloud provider API key (gateway only — never on the frontend)
E2B_API_KEY=

# Shared secret — same value as XIBECODE_GATEWAY_TOKEN on the web app
XIBECODE_GATEWAY_TOKEN=

PORT=8787

# Published E2B template aliases. The web app sends runtime=xibecode or runtime=supercharge
# per instance; the gateway selects the matching alias at creation and reattach time.
XIBECODE_E2B_TEMPLATE=xibecode-full-sandbox
SUPERCHARGE_E2B_TEMPLATE=supercharge-full-sandbox
# Supercharge hot-update feed for existing sandboxes (no new template):
# SUPERCHARGE_E2B_UPDATE_REPO=iotserver24/supercharge
# SUPERCHARGE_E2B_UPDATE_BASE_URL=https://github.com/iotserver24/supercharge/releases/latest/download

# https://e2b.dev/docs/sandbox/auto-resume
# onTimeout=pause (full memory snapshot) + autoResume=true — wake on SDK/HTTP activity
XIBECODE_E2B_ON_TIMEOUT=pause
XIBECODE_E2B_AUTO_RESUME=true
# Idle before pause (ms). Default 15m = 900000; 30m = 1800000
XIBECODE_E2B_SANDBOX_TIMEOUT_MS=900000
# Pause+resume before E2B 24h continuous-run hard limit (default 23h). 0=off.
XIBECODE_E2B_MAX_CONTINUOUS_MS=82800000

# XibeCode daemon overrides (normally leave defaults).
# XIBECODE_SANDBOX_DAEMON_COMMAND=xibecode daemon --workdir /home/user/workspace
# XIBECODE_SANDBOX_DAEMON_PIDFILE=/tmp/xibecode-daemon.pid
# XIBECODE_SANDBOX_DAEMON_LOGFILE=/tmp/xibecode-daemon.log
# XIBECODE_SANDBOX_DAEMON_MATCH=node.*xibecode|xibecode/dist

# Supercharge daemon overrides (normally leave defaults).
# SUPERCHARGE_SANDBOX_DAEMON_COMMAND=/usr/local/bin/supercharge-superagent-server
# SUPERCHARGE_SANDBOX_DAEMON_PIDFILE=/tmp/supercharge-daemon.pid
# SUPERCHARGE_SANDBOX_DAEMON_LOGFILE=/tmp/supercharge-daemon.log
# SUPERCHARGE_SANDBOX_DAEMON_MATCH=supercharge-superagent-server|superagent-server
