{
  "name": "vectra-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "Vectra Cloud monorepo — apps/web (Vercel) + apps/gateway (Railway/Coolify)",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --prefix apps/web",
    "dev:gateway": "npm run dev --prefix apps/gateway",
    "dev:all": "npm run dev:gateway & npm run dev:web",
    "build": "npm run build:web",
    "build:web": "npm run build --prefix apps/web",
    "build:gateway": "npm run build --prefix apps/gateway",
    "start:web": "npm run start --prefix apps/web",
    "start:gateway": "npm run start --prefix apps/gateway"
  },
  "engines": {
    "node": "22.x"
  }
}
