{
  "name": "vectra-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "Vectra Cloud — closed-source managed AI coding sandboxes (site + gateway)",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "bun run dev:web",
    "dev:web": "bunx next dev --port 3001",
    "dev:gateway": "bun run --cwd packages/gateway dev",
    "dev:all": "bun run dev:gateway & bun run dev:web",
    "build:index": "bun scripts/build-index.mjs",
    "build": "bun run build:index && bunx next build",
    "start": "bunx next start --port 3001",
    "start:gateway": "bun run --cwd packages/gateway start",
    "types:check": "bunx fumadocs-mdx && bunx next typegen && bunx tsc --noEmit",
    "postinstall": "bunx fumadocs-mdx",
    "lint": "bunx eslint"
  },
  "dependencies": {
    "@langchain/core": "^1.1.5",
    "@langchain/openai": "^1.2.0",
    "@orama/orama": "^3.1.16",
    "@orama/plugin-data-persistence": "^3.1.16",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.2.4",
    "fumadocs-mdx": "14.1.0",
    "fumadocs-ui": "16.2.4",
    "langchain": "^1.2.0",
    "lit": "^3.3.1",
    "lucide-react": "^0.556.0",
    "mongodb": "^6.16.0",
    "nanoid": "^5.1.5",
    "next": "^16.0.10",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.10",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "packageManager": "bun@1.3.11"
}
