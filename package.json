{
  "name": "vectra-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "Vectra Cloud monorepo — apps/web (Vercel) + apps/gateway (Railway/Coolify)",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "bun run dev:web",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:gateway": "bun run --cwd apps/gateway dev",
    "dev:all": "bun run dev:gateway & bun run dev:web",
    "build": "bun run build:web",
    "build:web": "bun run --cwd apps/web build",
    "build:gateway": "bun run --cwd apps/gateway build",
    "start:web": "bun run --cwd apps/web start",
    "start:gateway": "bun run --cwd apps/gateway start"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=20"
  }
}
