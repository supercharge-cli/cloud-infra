# Vectra Cloud gateway — never commit real secrets

E2B_API_KEY=
XIBECODE_GATEWAY_TOKEN=
PORT=8787

# Hosting template (4 vCPU / 8 GB)
XIBECODE_E2B_TEMPLATE=xibecode-full-sandbox
XIBECODE_E2B_ON_TIMEOUT=pause
XIBECODE_E2B_AUTO_RESUME=true
XIBECODE_E2B_SANDBOX_TIMEOUT_MS=900000
XIBECODE_E2B_MAX_CONTINUOUS_MS=82800000
